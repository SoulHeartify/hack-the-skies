<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Skybound — World Atlas</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Rajdhani:wght@500;600;700&display=swap');
*{box-sizing:border-box}body{margin:0;background:#07121e;color:#eaf7ff;font:16px Rajdhani,sans-serif}.app{min-height:100vh;padding:22px;background:radial-gradient(ellipse at 50% 45%,#153044,#07121e 70%)}header{max-width:1400px;margin:0 auto 18px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:13px}.logo{display:grid;place-items:center;width:45px;height:45px;border:1px solid #41dfd1;border-radius:12px;color:#5bf3e4;font-size:24px;background:#102a37;box-shadow:0 0 20px #35dacc33}.brand h1{font:700 17px Orbitron;margin:0;letter-spacing:2px}.brand small{display:block;color:#7693a4;font-size:11px;letter-spacing:2px;margin-top:4px}.stats{display:flex;gap:9px}.stat,.panel{background:#0d1d2a;border:1px solid #263e4f;border-radius:9px}.stat{padding:8px 14px;min-width:108px}.stat small{display:block;text-transform:uppercase;letter-spacing:1px;color:#819aaa;font-size:10px}.stat b{font:500 13px Orbitron;color:#d4fff7}.gold{color:#ffd073!important}.content{max-width:1400px;margin:auto;display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:15px}.map{height:min(70vh,680px);min-height:470px;position:relative;overflow:hidden;border:1px solid #294555;border-radius:13px;background:#0b2230;box-shadow:0 20px 60px #0007}.map canvas{width:100%;height:100%;display:block}.map-head{position:absolute;top:20px;left:22px;pointer-events:none}.map-head small{font:500 10px Orbitron;color:#55e9db;letter-spacing:2px}.map-head h2{font:700 20px Orbitron;margin:7px 0;text-shadow:0 2px 8px #000}.tools{position:absolute;right:15px;top:15px;display:flex;gap:6px}.tools button, .action{cursor:pointer;border:1px solid #304a5b;background:#0a1a28eF;color:#b5ccd7;border-radius:6px;padding:8px 12px;font:600 12px Rajdhani}.tools button:hover,.action:hover{color:#5df0e2;border-color:#42d9ce}.legend{position:absolute;bottom:14px;left:16px;display:flex;gap:13px;background:#07131ddd;padding:8px 11px;border:1px solid #29404f;border-radius:6px;color:#9bb1bd;font-size:11px}.dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#55f2df;box-shadow:0 0 7px currentColor;margin-right:5px}.dot.mission{background:#ffc761}.dot.danger{background:#ff6477}.side{display:flex;flex-direction:column;gap:12px}.panel{padding:16px}.label{font:500 10px Orbitron;color:#7896a8;letter-spacing:1.6px;margin-bottom:13px}.panel h3{font:600 16px Orbitron;margin:0 0 7px}.panel p{color:#95aebb;font-size:13px;line-height:1.45;margin:0}.mission{border-left:2px solid #48e5d7;padding-left:10px}.bar{height:5px;background:#263c49;border-radius:5px;margin-top:8px}.bar i{display:block;width:68%;height:100%;background:#45dfcb}.row{display:flex;justify-content:space-between;border-top:1px solid #253b49;margin-top:12px;padding-top:9px;color:#819aa9;font-size:12px}.row b{color:#e1f3f4}.action{width:100%;margin-top:13px;color:#52e9dc;border-color:#287d7d;background:#102d34;font:500 10px Orbitron}.crew{display:flex;align-items:center;gap:10px;padding:6px 0}.avatar{width:33px;height:33px;display:grid;place-items:center;background:#153642;border:1px solid #32616a;border-radius:9px;color:#66e6d8;font:12px Orbitron}.crew b{display:block;font-size:13px}.crew small{color:#819aa9}.online{margin-left:auto;width:6px;height:6px;border-radius:50%;background:#62e8a4;box-shadow:0 0 7px #62e8a4}.toast{position:absolute;top:65px;left:50%;transform:translateX(-50%);padding:9px 15px;border:1px solid #39d6cc;background:#0b2531;color:#d9fffa;border-radius:6px;opacity:0;transition:opacity .2s;pointer-events:none}.toast.show{opacity:1}@media(max-width:800px){.content{grid-template-columns:1fr}.map{height:58vh}.side{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}}@media(max-width:520px){.app{padding:12px}header{display:block}.stats{margin-top:14px}.stat{flex:1;min-width:0}.map{min-height:430px;height:55vh}.map-head{left:14px}.map-head h2{font-size:16px}.legend{left:8px;gap:8px;font-size:10px}}
</style></head>
<body><main class="app"><header><div class="brand"><div class="logo">✦</div><div><h1>SKYBOUND</h1><small>FLIGHT COMMAND // SECTOR 07</small></div></div><div class="stats"><div class="stat"><small>Credits</small><b class="gold">◈ 12,480</b></div><div class="stat"><small>Fuel</small><b>◉ 86%</b></div><div class="stat"><small>Flight rank</small><b>ACE · 04</b></div></div></header>
<section class="content"><div class="map"><canvas id="atlas"></canvas><div class="map-head"><small>TACTICAL OVERVIEW</small><h2>WORLD ATLAS</h2></div><div class="tools"><button id="minus" aria-label="Zoom out">−</button><button id="plus" aria-label="Zoom in">＋</button><button id="reset">⌖ RESET</button></div><div id="toast" class="toast">Waypoint locked</div><div class="legend"><span><i class="dot"></i>OUTPOST</span><span><i class="dot mission"></i>MISSION</span><span><i class="dot danger"></i>DANGER</span></div></div>
<aside class="side"><section class="panel"><div class="label">// ACTIVE OPERATION</div><div class="mission"><h3>Ghost Signal</h3><p>Investigate an uncharted transmission beyond the northern ridge.</p></div><div class="row"><span>MISSION READINESS</span><b>68%</b></div><div class="bar"><i></i></div></section><section class="panel"><div class="label">// SELECTED LOCATION</div><h3 id="name">Kestrel Reach</h3><p id="description">A remote launch outpost overlooking the cobalt sea.</p><div class="row"><span>SECTOR</span><b id="sector">07 · WEST</b></div><button class="action" id="waypoint">SET WAYPOINT →</button></section><section class="panel"><div class="label">// FLIGHT CREW</div><div class="crew"><div class="avatar">NV</div><div><b>Nova Vance</b><small>Pilot · Level 24</small></div><i class="online"></i></div><div class="crew"><div class="avatar">RK</div><div><b>Rook Kade</b><small>Navigator · Level 19</small></div><i class="online"></i></div></section></aside></section></main>
<script>
const canvas=document.querySelector('#atlas'),ctx=canvas.getContext('2d');let zoom=1,chosen=0,tick=0,W=0,H=0;
const places=[{name:'Kestrel Reach',desc:'A remote launch outpost overlooking the cobalt sea.',sector:'07 · WEST',x:.19,y:.34,type:'base'},{name:'Aurora Station',desc:'A bustling skyport beneath the northern lights.',sector:'02 · NORTH',x:.49,y:.20,type:'base'},{name:'Ghost Signal',desc:'Unknown transmission detected. Mission objective nearby.',sector:'09 · NORTH',x:.62,y:.29,type:'mission'},{name:'Obsidian Expanse',desc:'Restricted airspace with unstable weather and hostile patrols.',sector:'11 · EAST',x:.84,y:.46,type:'danger'},{name:'Sundown Harbor',desc:'A trade hub where pilots refuel before the long crossing.',sector:'05 · SOUTH',x:.68,y:.72,type:'base'},{name:'Verdant Basin',desc:'An isolated settlement beneath the cloud forest.',sector:'04 · SOUTH',x:.32,y:.65,type:'base'},{name:'Frostline Relay',desc:'An abandoned relay station buried in the polar shelf.',sector:'01 · FAR NORTH',x:.36,y:.12,type:'mission'}];
const continents=[[[.08,.30],[.12,.22],[.20,.18],[.27,.24],[.31,.31],[.27,.40],[.24,.48],[.20,.57],[.15,.55],[.12,.45],[.08,.40]],[[.25,.58],[.32,.55],[.37,.62],[.38,.71],[.34,.88],[.30,.83],[.28,.72]],[[.42,.24],[.49,.18],[.58,.2],[.63,.26],[.7,.24],[.78,.29],[.86,.29],[.91,.36],[.87,.43],[.79,.44],[.75,.50],[.68,.48],[.64,.54],[.57,.50],[.53,.45],[.48,.46],[.44,.40],[.40,.33]],[[.56,.55],[.64,.52],[.69,.59],[.70,.70],[.65,.86],[.61,.81],[.58,.70]]];
function draw(){const r=canvas.getBoundingClientRect(),d=devicePixelRatio||1;if(canvas.width!==r.width*d||canvas.height!==r.height*d){canvas.width=r.width*d;canvas.height=r.height*d;W=r.width;H=r.height}ctx.setTransform(d,0,0,d,0,0);ctx.clearRect(0,0,W,H);let g=ctx.createLinearGradient(0,0,W,H);g.addColorStop(0,'#0b2937');g.addColorStop(1,'#102331');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);ctx.save();ctx.translate(W/2,H/2);ctx.scale(zoom,zoom);ctx.translate(-W/2,-H/2);
continents.forEach(poly=>{ctx.beginPath();poly.forEach(([x,y],i)=>i?ctx.lineTo(x*W,y*H):ctx.moveTo(x*W,y*H));ctx.closePath();ctx.fillStyle='#31575b';ctx.fill();ctx.strokeStyle='#60b3a477';ctx.lineWidth=1.4;ctx.stroke();});[[0,1],[1,2],[2,3],[0,5],[5,4],[4,3],[1,6]].forEach(([a,b])=>{ctx.beginPath();ctx.moveTo(places[a].x*W,places[a].y*H);ctx.quadraticCurveTo((places[a].x+places[b].x)*W/2,(places[a].y+places[b].y)*H/2-14,places[b].x*W,places[b].y*H);ctx.setLineDash([4,6]);ctx.strokeStyle='#8ad9cf66';ctx.stroke();ctx.setLineDash([])});
places.forEach((p,i)=>{const x=p.x*W,y=p.y*H,c=p.type==='mission'?'#ffc761':p.type==='danger'?'#ff6477':'#55f2df';if(i===chosen){ctx.beginPath();ctx.arc(x,y,11+Math.sin(tick)*3,0,7);ctx.strokeStyle=c+'77';ctx.stroke()}ctx.beginPath();ctx.arc(x,y,4.5,0,7);ctx.fillStyle=c;ctx.shadowColor=c;ctx.shadowBlur=12;ctx.fill();ctx.shadowBlur=0;ctx.font='600 11px Rajdhani';ctx.fillStyle='#c5dadd';ctx.fillText(p.name,x+9,y-8)});ctx.restore();tick+=.05;requestAnimationFrame(draw)}
canvas.addEventListener('click',e=>{const r=canvas.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;let i=places.findIndex(p=>Math.hypot(x-p.x*W,y-p.y*H)<28*zoom);if(i<0)return;chosen=i;document.querySelector('#name').textContent=places[i].name;document.querySelector('#description').textContent=places[i].desc;document.querySelector('#sector').textContent=places[i].sector});document.querySelector('#plus').onclick=()=>zoom=Math.min(1.7,zoom+.15);document.querySelector('#minus').onclick=()=>zoom=Math.max(.8,zoom-.15);document.querySelector('#reset').onclick=()=>zoom=1;document.querySelector('#waypoint').onclick=()=>{const t=document.querySelector('#toast');t.textContent='Waypoint locked: '+places[chosen].name;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1700)};new ResizeObserver(draw).observe(canvas);draw();
</script></body></html>
